{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gov_core://schemas/langfuse_metadata/v1",
  "title": "GovCoreLangfusePropagatedMetadata",
  "description": "Keys allowed in Langfuse propagate_attributes(metadata=...). Values <=200 chars ASCII-safe. session_id is set separately on propagate_attributes(session_id=...) at root trace creation.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[A-Za-z0-9_]{1,64}$"
  },
  "properties": {
    "trace_schema_version": { "const": "v1" },
    "trace_id": { "type": "string", "maxLength": 200 },
    "session_id": { "type": "string", "maxLength": 200 },
    "task_id": { "type": "string", "maxLength": 200 },
    "workflow_id": { "type": "string", "maxLength": 200 },
    "mode": {
      "type": "string",
      "description": "Legacy alias for workflow_id (ask | ingest_verify); prefer workflow_id in new metadata."
    },
    "department": { "type": "string", "maxLength": 200 },
    "status": { "type": "string", "maxLength": 200 },
    "release": { "type": "string", "maxLength": 200 },
    "human_review_required": { "type": "boolean" },
    "handoff_status": { "type": "string", "maxLength": 200 },
    "env": { "type": "string", "maxLength": 200 },
    "agent_name": { "type": "string", "maxLength": 200 },
    "model_name": { "type": "string", "maxLength": 200 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "error_type": { "type": "string", "maxLength": 200 },
    "code": { "type": "string", "maxLength": 200 },
    "retryable": { "type": "boolean" },
    "pipeline_ok": { "type": "boolean" },
    "answer_ok": { "type": "boolean" },
    "pg_ok": { "type": "boolean" },
    "budget_schema_version": { "const": "v1" },
    "run_id": { "type": "string", "maxLength": 200 },
    "action": { "enum": ["allow", "warn", "block"] },
    "checkpoint_config_schema_version": { "const": "v1" },
    "attempt": { "type": "integer", "minimum": 1 },
    "checkpoint_key": { "type": "string", "maxLength": 200 },
    "interrupt_reason": { "type": "string", "maxLength": 200 }
  },
  "additionalProperties": false
}
