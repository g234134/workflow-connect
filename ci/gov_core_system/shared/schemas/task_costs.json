{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gov_core://schemas/task_costs/v1",
  "title": "GovCoreTaskCosts",
  "description": "Per-task or per-node cost record for correlation with Langfuse trace and budget snapshots.",
  "type": "object",
  "required": [
    "task_costs_schema_version",
    "task_id",
    "trace_id",
    "total_cost_usd"
  ],
  "properties": {
    "task_costs_schema_version": { "const": "v1" },
    "task_id": { "type": "string", "maxLength": 200 },
    "trace_id": { "type": "string", "maxLength": 200 },
    "session_id": { "type": "string", "maxLength": 200 },
    "workflow_id": { "type": "string", "maxLength": 200 },
    "agent_name": { "type": "string", "maxLength": 200 },
    "model_name": { "type": "string", "maxLength": 200 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
