{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gov.local/schemas/batch_subtask.schema.json",
  "title": "Batch Subtask",
  "description": "MVP schema for a single batch orchestrator subtask.",
  "$ref": "#/$defs/subtask",
  "$defs": {
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_ticket_id",
        "subtask_id",
        "subtask_type",
        "target_paths",
        "allowed_paths",
        "blocked_paths",
        "scope_summary",
        "acceptance_checks",
        "priority",
        "dependencies",
        "status",
        "preferred_model"
      ],
      "properties": {
        "parent_ticket_id": {
          "type": "string",
          "minLength": 1,
          "description": "Parent ticket identifier that owns this subtask."
        },
        "subtask_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique subtask identifier within the parent batch."
        },
        "subtask_type": {
          "type": "string",
          "enum": ["implementer", "reviewer", "scribe", "orchestrator"],
          "description": "Multi-Chat role assigned to this subtask."
        },
        "target_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Primary paths this subtask is expected to touch."
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Paths the worker may modify for this subtask."
        },
        "blocked_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Paths the worker must not modify."
        },
        "scope_summary": {
          "type": "string",
          "minLength": 1,
          "description": "Short human-readable summary of subtask scope."
        },
        "acceptance_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Verification commands or checks that define done."
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "description": "Execution priority; lower numbers run earlier."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Other subtask_id values that must complete first."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "review", "done", "blocked", "skipped"],
          "description": "Current lifecycle status for scheduling."
        },
        "preferred_model": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Optional model preference for the assigned role."
        }
      }
    },
    "batch_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "parent_ticket_id", "subtasks"],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "subtasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subtask"
          }
        }
      }
    }
  }
}
