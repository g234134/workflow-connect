  "scope_hint": "僅改尚書省／任務卡明示範圍；他人 core 與他人 workspace 三件套禁止接管；Progress／Conditions 僅末尾追加。",
  "forbidden_zone_hint": "憲法 §7 禁區類型（具體路徑見 INSTANCE_ANCHOR_TANG.md）：環境密鑰、venv 樹、未授權 runtime checkpoint、暗部破壞性維運、總部清算腳本；禁止輸出 .env／金鑰原文。",
  "manual_decision_items": [
    "是否已獲尚書省施工授權",
    "是否觸及高風險禁區（需 override 留痕）",
    "是否可標可交付（需 runner 證據，見 OPS_CYCLE）",
    "是否 append 戰報至 00_Agent_Work_Progress.md"
  ],
  "risk_path_patterns": [
    "\\.env",
    "runtime[/\\\\]checkpoints",
    "01_Environments[/\\\\]python_venvs",
    "project_status[/\\\\]master_status\\.md",
    "project_status[/\\\\]handoff\\.md",
    "Chariot_Registry\\.db"
  ],
  "governance_path_patterns": [
    "04_Workflows[/\\\\]00_Agent_Work_Progress\\.md",
    "04_Workflows[/\\\\]00_Agent_Work_Conditions\\.md",
    "04_Workflows[/\\\\]HARNESS_CONSTITUTION\\.md",
    "04_Workflows[/\\\\]ENGINEERING_CONTRACT\\.md",
    "AGENTS\\.md"
  ],
  "default_battle_report": {
