      "        -1, 2, -1, 0, 0, 0, 0, -1, 2])",
      "    assert c.cartan_matrix() == m",
      "    assert c.dimension() == 8",
      "    assert c.simple_root(6) == [0, 0, 0, -1, 1, 0, 0, 0]"
