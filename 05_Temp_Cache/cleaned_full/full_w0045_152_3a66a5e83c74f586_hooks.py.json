      "import contextlib",
      "# Executed in the order they're registered",
      "INTERMEDIATE_HOOKS = []",
      "@contextlib.contextmanager",
      "def intermediate_hook(fn):",
      "    INTERMEDIATE_HOOKS.append(fn)",
      "    try:",
      "        yield",
      "    finally:",
      "        INTERMEDIATE_HOOKS.pop()"
