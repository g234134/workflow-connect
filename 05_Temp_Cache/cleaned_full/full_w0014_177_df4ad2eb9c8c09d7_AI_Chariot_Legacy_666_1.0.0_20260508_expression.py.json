      "ident:      (\\w|:|\\+|-|\\.|\\[|\\]|\\\\|/)+",
      "kwargs:     ('(' name '=' value ( ', ' name '=' value )*  ')')",
      "name:       a valid ident, but not a reserved keyword",
      "value:      (unescaped) string literal | (-)?[0-9]+ | 'False' | 'True' | 'None'"
