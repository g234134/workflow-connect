      "from sympy.core.symbol import symbols",
      "from sympy.functions.combinatorial.factorials import binomial",
      "from sympy.functions.combinatorial.numbers import (fibonacci, lucas)",
      "def test_approximants():",
      "    x, t = symbols(\"x,t\")",
