      "from io import BytesIO",
      "from fontTools.misc.macRes import ResourceReader, ResourceError",
      "def getSFNTResIndices(path):",
      "    \"\"\"Determine whether a file has a 'sfnt' resource fork or not.\"\"\"",
      "    try:",
