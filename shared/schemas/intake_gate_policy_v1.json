{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "intake_gate_policy_v1",
  "title": "Intake Gate Policy v1",
  "type": "object",
  "required": [
    "policy_version",
    "schema_version",
    "defaults",
    "allowlist_tiers",
    "supported_task_types",
    "deny_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "type": "string",
      "const": "intake_gate_policy_v1"
    },
    "schema_version": {
      "type": "string",
      "const": "intake_gate_policy_v1"
    },
    "defaults": {
      "type": "object",
      "required": [
        "unsupported_task_type",
        "non_tabular_without_extended_flag",
        "unknown_client"
      ],
      "additionalProperties": false,
      "properties": {
        "unsupported_task_type": {
          "type": "string",
          "enum": ["reject", "review_needed"]
        },
        "non_tabular_without_extended_flag": {
          "type": "string",
          "enum": ["reject", "review_needed"]
        },
        "unknown_client": {
          "type": "string",
          "enum": ["reject", "review_needed"]
        }
      }
    },
    "allowlist_tiers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/allowlist_tier" }
    },
    "supported_task_types": {
      "type": "object",
      "required": ["tabular", "non_tabular"],
      "additionalProperties": false,
      "properties": {
        "tabular": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "non_tabular": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deny_rules": {
      "type": "array",
      "items": { "$ref": "#/definitions/deny_rule" }
    }
  },
  "definitions": {
    "allowlist_tier": {
      "type": "object",
      "required": ["profile_id", "tier", "maturity"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "tier": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "NT-A", "NT-B", "unknown"]
        },
        "maturity": {
          "type": "string",
          "enum": ["stable", "experimental", "shadow", "unknown"]
        },
        "requires_extended_fixture_flag": { "type": "boolean" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "client_refs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "deny_rule": {
      "type": "object",
      "required": ["rule_id", "reason_code", "match"],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "reason_code": {
          "type": "string",
          "enum": [
            "policy_deny_phi",
            "policy_deny_web_scraping",
            "policy_deny_audio_video",
            "policy_deny_scale_exceeds"
          ]
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sensitivity_values": {
              "type": "array",
              "items": { "type": "string" }
            },
            "intake_flags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "provenance_source_types": {
              "type": "array",
              "items": { "type": "string" }
            },
            "structure_values": {
              "type": "array",
              "items": { "type": "string" }
            },
            "scale_limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_row_count": { "type": "integer", "minimum": 1 },
                "max_file_size_bytes": { "type": "integer", "minimum": 1 },
                "max_batch_files": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
